# 复制成 .env 再填（.env 已在 .gitignore 里，不会上传）
# 面板启动时自动加载；只补缺，不覆盖已经存在的环境变量。

# 模型供应商的 key（变量名要和面板「模型供应商」里的 key_env 一致）
# 例：面板里 provider.key_env = "MY_LLM_API_KEY"，这里就填 MY_LLM_API_KEY=sk-...
MY_LLM_API_KEY=
WORKBUDDY_API_KEY=
MIMO_API_KEY=

# 语音合成（MIMO TTS）
MIMO_TTS_API_KEY=

# 可选：面板写操作的额外令牌（设置后所有 POST 都要带 Authorization: Bearer <它>）
# KLEE_STUDIO_TOKEN=

# 可选：换端口
# KLEE_STUDIO_PORT=8796
