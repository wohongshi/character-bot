# 运行态：聊天记录、QQ 号、token、模型配置、缓存 —— 绝不入库
state/
bot/features/state/
bot/features/cards/
bot/features/__pycache__/
bot/features/.reload

# 密钥
.env
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Go 边缘层构建产物
edge/bin/

# 构建/日志/截图
.buildlogs/
logs/
*.log
shots/
*.tmp

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/

# 外部插件编译产物（源码在仓库里，跑 build.sh 生成）
bot/features/ext/tools/*.bin
bot/features/ext/tools/classes/

# 外部插件握手缓存（运行时生成，删掉会自动重建）
state/extmeta/
bot/features/extmeta/

# 插件首次出现的记录（运行时生成，删了会自动重建）
bot/features/known.json

# 原生扩展编译产物（源码在 tools/native/，跑 tools/build_native.sh 生成）
bot/native/lib/

# .NET 构建产物
tools/pkgcheck/bin/
tools/pkgcheck/obj/
